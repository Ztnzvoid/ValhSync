# systemd unit for valsync-server (Linux).
#
#   sudo useradd --system --home /opt/valsync --shell /usr/sbin/nologin valsync
#   sudo mkdir -p /opt/valsync && sudo chown valsync: /opt/valsync
#   sudo -u valsync /opt/valsync/valsync-server --config /opt/valsync/valsync-server.toml init \
#        --server-root /home/steam/valheim --name "My server" \
#        --game-address valheim.example.org:2456 --public-url http://valheim.example.org:2470
#   sudo cp valsync-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now valsync-server
#   journalctl -u valsync-server -f
#
# The service user needs read access to the dedicated server's BepInEx folder
# (it never writes there) and write access to /opt/valsync.

[Unit]
Description=ValSync mod pack publisher for Valheim
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=valsync
Group=valsync
WorkingDirectory=/opt/valsync
ExecStart=/opt/valsync/valsync-server --config /opt/valsync/valsync-server.toml serve
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info

# Hardening: read-only system, private tmp, no new privileges. Add the game
# server's folder to ReadOnlyPaths if it lives outside /home.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/valsync

[Install]
WantedBy=multi-user.target
